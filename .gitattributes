# Normalize line endings: LF in the repository and on checkout, as in the author's other projects.
# PowerShell scripts and the solution file stay CRLF, the line ending their Windows tools write.
* text=auto eol=lf
*.ps1 text eol=crlf
*.sln text eol=crlf

# Binary assets
*.png  binary
*.ico  binary
*.vsix binary
*.3mf  binary

# Keep GitHub language stats focused on the actual source
*.vsct      linguist-language=XML
*.vsixmanifest linguist-language=XML
